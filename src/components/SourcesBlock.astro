---
interface Source {
	name: string;
	url: string;
}

interface Props {
	sources: Source[];
	title?: string;
}

const { sources, title = 'Sources' } = Astro.props;
---

{
	sources.length > 0 && (
		<section class="sources-section">
			<h2>{title}</h2>

			<ol>
				{
					sources.map((source) => (
						<li>
							<a
								href={source.url}
								target="_blank"
								rel="noopener noreferrer"
							>
								{source.name}
							</a>
						</li>
					))
				}
			</ol>
		</section>
	)
}
