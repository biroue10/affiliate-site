---
interface Props {
	href: string;
	label?: string;
	partner?: string;
	position?: string;
	articleSlug?: string;
	language?: 'fr' | 'en';
}

const {
	href,
	label = 'Voir l’offre',
	partner = 'unknown',
	position = 'article',
	articleSlug,
	language = 'fr',
} = Astro.props;
---

<div class="affiliate-cta">
	<p class="affiliate-cta-disclosure">
		{language === 'en' ? 'Some links may be affiliate links. We may earn a commission at no additional cost to you.' : 'Certains liens peuvent être partenaires. Cela peut nous rémunérer, sans frais supplémentaires pour vous.'}
	</p>

	<a
		class="affiliate-button"
		href={href}
		target="_blank"
		rel="sponsored noopener noreferrer"
		data-affiliate-partner={partner}
		data-affiliate-position={position}
		data-affiliate-slug={articleSlug}
		data-affiliate-language={language}
	>
		{label}
	</a>
</div>
