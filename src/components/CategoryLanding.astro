---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import Breadcrumbs from './Breadcrumbs.astro';
import type { CategorySlug } from '../consts';
import {
	getPublishedEnglishPosts,
	getPublishedPosts,
	getPublishedReviews,
} from '../lib/content';
import { ARTICLE_TRANSLATIONS, CATEGORY_PATHS, type Locale } from '../lib/i18n';

interface Props {
	category: CategorySlug;
	title: string;
	description: string;
	intro: string;
	language?: Locale;
}

const {
	category,
	title,
	description,
	intro,
	language = 'fr',
} = Astro.props;

const posts =
	language === 'en'
		? await getPublishedEnglishPosts(category)
		: category === 'avis'
		? await getPublishedReviews()
		: await getPublishedPosts(category);

const siteBase = Astro.site ?? new URL(Astro.url.origin);
const getEnglishPath = (id: string) => ARTICLE_TRANSLATIONS[id as keyof typeof ARTICLE_TRANSLATIONS]?.en ?? '/en/ai-companions/';
const getCardPath = (id: string, category: string) => language === 'en'
	? getEnglishPath(id)
	: `/${category}/${id}/`;

const collectionSchema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: title,
	description,
	url: new URL(language === 'en' ? CATEGORY_PATHS.en[category as keyof typeof CATEGORY_PATHS.en] : `/${category}/`, siteBase).href,
	inLanguage: language,
};
---

<BaseLayout
	title={title}
	description={description}
	schemas={[collectionSchema]}
>
	<div class="container page-shell">
		<Breadcrumbs
			items={[
				{ label: language === 'en' ? 'Home' : 'Accueil', href: language === 'en' ? '/en/ai-companions/' : '/' },
				{ label: title, href: language === 'en' ? CATEGORY_PATHS.en[category as keyof typeof CATEGORY_PATHS.en] : `/${category}/` },
			]}
			language={language}
		/>

		<header class="page-header">
			<p class="eyebrow">Sélection éditoriale</p>

			<h1>{title}</h1>

			<p>{intro}</p>
		</header>

		{
			posts.length > 0 ? (
				<div class="article-grid">
					{
						posts.map((post) => (
							<article class="article-card">
								{
									post.data.heroImage && (
										<a
											class="article-card-image"
											href={getCardPath(post.id, post.data.category)}
											aria-label={`Lire : ${post.data.title}`}
										>
											<Image
												src={post.data.heroImage}
												width={800}
												height={450}
												alt={post.data.heroAlt ?? post.data.title}
												loading="lazy"
											/>
										</a>
									)
								}

								<p class="article-category">
									{post.data.category}
								</p>

								<h2>
									<a href={getCardPath(post.id, post.data.category)}>
										{post.data.title}
									</a>
								</h2>

								<p>{post.data.description}</p>
							</article>
						))
					}
				</div>
			) : (
				<div class="empty-state">
					<h2>{language === 'en' ? 'Our first articles are coming soon.' : 'Nos premiers contenus arrivent bientôt.'}</h2>
					<p>{language === 'en' ? 'We are preparing the first analyses in this category.' : 'Nous préparons actuellement les premières analyses de cette catégorie.'}</p>
				</div>
			)
		}
	</div>
</BaseLayout>
