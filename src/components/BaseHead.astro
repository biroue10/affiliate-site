---
import '../styles/global.css';

import type { ImageMetadata } from 'astro';

import {
	SITE_AUTHOR,
	SITE_LOCALE,
	SITE_TITLE,
} from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	canonical?: string;
	noindex?: boolean;
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	adultContent?: boolean;
	language?: 'fr' | 'en';
	frAlternate?: string;
	enAlternate?: string;
}

const {
	title,
	description,
	image = '/og-default.png',
	canonical,
	noindex = false,
	type = 'website',
	publishedTime,
	modifiedTime,
	adultContent = false,
	language = 'fr',
	frAlternate,
	enAlternate,
} = Astro.props;

const siteBase = Astro.site ?? new URL(Astro.url.origin);

const canonicalURL = canonical
	? new URL(canonical, siteBase)
	: new URL(Astro.url.pathname, siteBase);

const imageURL =
	typeof image === 'string'
		? new URL(image, siteBase)
		: new URL(image.src, siteBase);

const imageWidth = typeof image === 'string' ? undefined : image.width;
const imageHeight = typeof image === 'string' ? undefined : image.height;

const effectiveNoindex =
	noindex || siteBase.hostname.endsWith('.invalid');

const robotsContent = effectiveNoindex
	? 'noindex, nofollow'
	: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<!-- Global metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#ee5f91" />

<link rel="sitemap" href="/sitemap-index.xml" />

<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', siteBase)}
/>

<!-- Indexation -->
<meta name="robots" content={robotsContent} />

<!-- Canonical -->
<link rel="canonical" href={canonicalURL} />
{frAlternate && <link rel="alternate" hreflang="fr" href={new URL(frAlternate, siteBase)} />}
{enAlternate && <link rel="alternate" hreflang="en" href={new URL(enAlternate, siteBase)} />}
{frAlternate && <link rel="alternate" hreflang="x-default" href={new URL(frAlternate, siteBase)} />}

<!-- Primary metadata -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={language === 'en' ? 'Clairlia editorial team' : SITE_AUTHOR} />
<meta http-equiv="content-language" content={language} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
{imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
{imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={language === 'en' ? 'en_US' : SITE_LOCALE} />
<meta property="og:locale:alternate" content={language === 'en' ? 'fr_FR' : 'en_US'} />

<!-- Article metadata -->
{
	type === 'article' && publishedTime && (
		<meta property="article:published_time" content={publishedTime.toISOString()} />
	)
}

{
	type === 'article' && modifiedTime && (
		<meta property="article:modified_time" content={modifiedTime.toISOString()} />
	)
}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={title} />

<!-- Only use this flag for pages containing explicit adult content -->
{adultContent && <meta name="rating" content="adult" />}
