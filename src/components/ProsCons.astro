---
interface Props {
	pros: string[];
	cons: string[];
	language?: 'fr' | 'en';
}

const { pros, cons, language = 'fr' } = Astro.props;
---

{
	(pros.length > 0 || cons.length > 0) && (
		<div class="pros-cons">
			<section class="pros-box">
				<h2>{language === 'en' ? 'Pros' : 'Avantages'}</h2>

				<ul>
					{pros.map((item) => <li>{item}</li>)}
				</ul>
			</section>

			<section class="cons-box">
				<h2>{language === 'en' ? 'Cons' : 'Inconvénients'}</h2>

				<ul>
					{cons.map((item) => <li>{item}</li>)}
				</ul>
			</section>
		</div>
	)
}
