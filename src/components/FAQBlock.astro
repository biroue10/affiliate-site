---
interface FAQItem {
	question: string;
	answer: string;
}

interface Props {
	items: FAQItem[];
	language?: 'fr' | 'en';
}

const { items, language = 'fr' } = Astro.props;
---

{
	items.length > 0 && (
		<section class="faq-section">
			<p class="eyebrow">{language === 'en' ? 'Frequently asked questions' : 'Questions fréquentes'}</p>
			<h2>FAQ</h2>

			<div class="faq-list">
				{
					items.map((item) => (
						<details class="faq-item">
							<summary>{item.question}</summary>
							<p>{item.answer}</p>
						</details>
					))
				}
			</div>
		</section>
	)
}
