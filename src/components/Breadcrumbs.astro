---
interface BreadcrumbItem {
	label: string;
	href: string;
}

interface Props {
	items: BreadcrumbItem[];
	language?: 'fr' | 'en';
}

const { items, language = 'fr' } = Astro.props;

const siteBase = Astro.site ?? new URL(Astro.url.origin);

const schema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: items.map((item, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: item.label,
		item: new URL(item.href, siteBase).href,
	})),
};
---

<nav class="breadcrumbs" aria-label={language === 'en' ? 'Breadcrumb' : 'Fil d’Ariane'}>
	<ol>
		{
			items.map((item, index) => (
				<li>
					{
						index === items.length - 1 ? (
							<span aria-current="page">{item.label}</span>
						) : (
							<a href={item.href}>{item.label}</a>
						)
					}
				</li>
			))
		}
	</ol>
</nav>

<script
	type="application/ld+json"
		is:inline
	set:html={JSON.stringify(schema)}
/>
