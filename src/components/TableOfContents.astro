---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
}

const { headings } = Astro.props;

const visibleHeadings = headings.filter(
	({ depth }) => depth === 2 || depth === 3,
);
---

{
	visibleHeadings.length > 1 && (
		<nav class="toc" aria-label="Sommaire">
			<p class="toc-title">Dans cet article</p>

			<ol>
				{
					visibleHeadings.map((heading) => (
						<li class={`toc-depth-${heading.depth}`}>
							<a href={`#${heading.slug}`}>
								{heading.text}
							</a>
						</li>
					))
				}
			</ol>
		</nav>
	)
}
