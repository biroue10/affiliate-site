---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
	language?: 'fr' | 'en';
}

const { headings, language = 'fr' } = Astro.props;

const visibleHeadings = headings.filter(
	({ depth }) => depth === 2,
);
---

{
	visibleHeadings.length > 1 && (
		<nav class="toc" aria-label={language === 'en' ? 'Table of contents' : 'Sommaire'}>
			<p class="toc-title">{language === 'en' ? 'In this article' : 'Dans cet article'}</p>

			<ol>
				{
					visibleHeadings.map((heading) => (
						<li class={`toc-depth-${heading.depth}`}>
							<a href={`#${heading.slug}`}>
								{heading.text}
							</a>
						</li>
					))
				}
			</ol>
		</nav>
	)
}
