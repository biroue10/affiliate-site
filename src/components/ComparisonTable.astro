---
type Cell = string | { text: string; href: string };

interface Props {
	headers: string[];
	rows: Cell[][];
}

const { headers, rows } = Astro.props;
---

<div class="comparison-table-wrapper">
	<table class="comparison-table">
		<thead>
			<tr>
				{headers.map((header) => <th scope="col">{header}</th>)}
			</tr>
		</thead>

		<tbody>
			{
				rows.map((row) => (
					<tr>
						{
							row.map((cell) => (
								<td>
									{typeof cell === 'string' ? (
										cell
									) : (
										<a href={cell.href}>{cell.text}</a>
									)}
								</td>
							))
						}
					</tr>
				))
			}
		</tbody>
	</table>
</div>
