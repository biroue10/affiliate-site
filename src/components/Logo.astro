---
interface Props {
	size?: 'sm' | 'md' | 'lg';
}

const { size = 'md' } = Astro.props;

const className =
	size === 'sm' ? 'logo logo-sm' :
	size === 'lg' ? 'logo logo-lg' :
	'logo logo-md';
---

<a class={className} href="/" aria-label="Clairlia - Accueil">
	<span class="logo-word">
		Clairl
		<span class="logo-i-wrap" aria-hidden="true">
			<span class="logo-stem">i</span>
			<svg
				class="logo-petal"
				viewBox="0 0 24 24"
				fill="none"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path
					d="M12.1 2.8C14.7 3.5 16.9 5.2 17.9 7.7C18.7 9.8 18.3 12.1 17 14C14.7 13.9 12.6 13.1 11 11.4C8.9 9.2 8.4 6.2 9.4 3.4C10.2 2.9 11.1 2.7 12.1 2.8Z"
					fill="currentColor"
				/>
				<path
					d="M9.8 10.3C12.9 10.4 15.3 11.6 16.9 14.2C17.8 15.6 18.1 17.1 17.9 18.7C16.5 19.1 15.1 19 13.6 18.4C10.6 17.1 8.9 14.6 8.3 11.5C8.7 11 9.2 10.6 9.8 10.3Z"
					fill="currentColor"
					opacity="0.9"
				/>
			</svg>
		</span>
		a
	</span>
</a>
