---
interface Props {
	size?: 'sm' | 'md' | 'lg';
}

const { size = 'md' } = Astro.props;

const className =
	size === 'sm' ? 'logo logo-sm' :
	size === 'lg' ? 'logo logo-lg' :
	'logo logo-md';
---

<a class={className} href="/" aria-label="Clairlia - Accueil">
	<img
		class="logo-image"
		src="/assets/logo-clairlia-rose.webp"
		alt="Clairlia - Accueil"
		width="1200"
		height="356"
	/>
</a>
