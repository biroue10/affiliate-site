<script is:inline>
	document.addEventListener('click', (event) => {
		const target = event.target instanceof Element
			? event.target.closest('[data-affiliate-partner]')
			: null;

		if (!(target instanceof HTMLAnchorElement)) return;

		const partner = target.dataset.affiliatePartner;
		const pageSlug = target.dataset.affiliateSlug;
		const language = target.dataset.affiliateLanguage;
		const position = target.dataset.affiliatePosition;

		if (!partner) return;

		const payload = {
			event: 'affiliate_click',
			partner,
			page_slug: pageSlug,
			language,
			position,
		};

		window.dispatchEvent(
			new CustomEvent('affiliate_click', { detail: payload }),
		);

		if (typeof window.gtag === 'function') {
			window.gtag('event', 'affiliate_click', payload);
		}

		if (typeof window.plausible === 'function') {
			window.plausible('affiliate_click', { props: payload });
		}
	});
</script>
