---
interface Props {
	type: 'avis' | 'comparatifs' | 'guides' | 'rencontres' | 'ai';
}

const { type } = Astro.props;
---

<div class="category-icon" aria-hidden="true">
	{
		type === 'avis' && (
			<svg viewBox="0 0 24 24" fill="none">
				<path d="M5 18.5L6.3 14.8C5.5 13.8 5 12.5 5 11C5 7.1 8.4 4 12.5 4C16.6 4 20 7.1 20 11C20 14.9 16.6 18 12.5 18H8.4L5 18.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
			</svg>
		)
	}

	{
		type === 'comparatifs' && (
			<svg viewBox="0 0 24 24" fill="none">
				<path d="M12 4V20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
				<path d="M6 7H18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
				<path d="M7.5 7C7.5 10 5.5 12 3.5 12C5.5 12 7.5 14 7.5 17C7.5 14 9.5 12 11.5 12C9.5 12 7.5 10 7.5 7Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
				<path d="M16.5 7C16.5 10 14.5 12 12.5 12C14.5 12 16.5 14 16.5 17C16.5 14 18.5 12 20.5 12C18.5 12 16.5 10 16.5 7Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
			</svg>
		)
	}

	{
		type === 'guides' && (
			<svg viewBox="0 0 24 24" fill="none">
				<path d="M4.5 6.5C4.5 5.7 5.2 5 6 5H10C11.2 5 12.4 5.4 13.4 6.2L14 6.7L14.6 6.2C15.6 5.4 16.8 5 18 5H18.5C19.3 5 20 5.7 20 6.5V18.5C20 19.3 19.3 20 18.5 20H18C16.8 20 15.6 20.4 14.6 21.2L14 21.7L13.4 21.2C12.4 20.4 11.2 20 10 20H6C5.2 20 4.5 19.3 4.5 18.5V6.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
				<path d="M14 6.7V21.7" stroke="currentColor" stroke-width="1.8"/>
			</svg>
		)
	}

	{
		type === 'rencontres' && (
			<svg viewBox="0 0 24 24" fill="none">
				<path d="M12 20.5L10.5 19.1C6.2 15.2 3.5 12.7 3.5 9.5C3.5 7 5.5 5 8 5C9.4 5 10.8 5.7 11.7 6.9L12 7.3L12.3 6.9C13.2 5.7 14.6 5 16 5C18.5 5 20.5 7 20.5 9.5C20.5 12.7 17.8 15.2 13.5 19.1L12 20.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
			</svg>
		)
	}

	{
		type === 'ai' && (
			<svg viewBox="0 0 24 24" fill="none">
				<path d="M12 3.5L13.7 8.3L18.5 10L13.7 11.7L12 16.5L10.3 11.7L5.5 10L10.3 8.3L12 3.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
			</svg>
		)
	}
</div>
