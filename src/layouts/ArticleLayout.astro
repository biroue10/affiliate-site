---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQBlock from '../components/FAQBlock.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ProsCons from '../components/ProsCons.astro';
import SourcesBlock from '../components/SourcesBlock.astro';
import TableOfContents from '../components/TableOfContents.astro';
import VerdictBox from '../components/VerdictBox.astro';

import {
	SITE_CATEGORIES,
	SITE_TITLE,
} from '../consts';

import BaseLayout from './BaseLayout.astro';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

type ArticleData = CollectionEntry<'blog'>['data'];

type Props = ArticleData & {
	headings?: Heading[];
};

const {
	title,
	seoTitle,
	description,
	pubDate,
	updatedDate,
	heroImage,
	heroAlt,
	author,
	category,
	affiliate,
	adultContent,
	noindex,
	canonical,
	verdict,
	pros,
	cons,
	faq,
	sources,
	sourcesTitle,
	headings = [],
} = Astro.props;

const siteBase = Astro.site ?? new URL(Astro.url.origin);

const pageURL = canonical
	? new URL(canonical, siteBase)
	: new URL(Astro.url.pathname, siteBase);

const categoryInfo = SITE_CATEGORIES.find(
	(item) => item.slug === category,
);

const categoryLabel = categoryInfo?.label ?? category;

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	url: pageURL.href,
	mainEntityOfPage: pageURL.href,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),

	author: {
		'@type': 'Organization',
		name: author,
		url: new URL('/equipe-editoriale/', siteBase).href,
	},

	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
	},

	...(heroImage
		? {
				image: new URL(heroImage.src, siteBase).href,
			}
		: {}),
};

const faqSchema =
	faq.length > 0
		? {
				'@context': 'https://schema.org',
				'@type': 'FAQPage',

				mainEntity: faq.map((item) => ({
					'@type': 'Question',
					name: item.question,

					acceptedAnswer: {
						'@type': 'Answer',
						text: item.answer,
					},
				})),
			}
		: null;

const schemas = faqSchema
	? [articleSchema, faqSchema]
	: [articleSchema];
---

<BaseLayout
	title={seoTitle ?? title}
	description={description}
	image={heroImage}
	canonical={canonical}
	noindex={noindex}
	type="article"
	publishedTime={pubDate}
	modifiedTime={updatedDate ?? pubDate}
	adultContent={adultContent}
	schemas={schemas}
>
	<div class="container article-shell">
		<Breadcrumbs
			items={[
				{ label: 'Accueil', href: '/' },
				{
					label: categoryLabel,
					href: `/${category}/`,
				},
				{
					label: title,
					href: Astro.url.pathname,
				},
			]}
		/>

		<article>
			<header class="article-header">
				<p class="eyebrow">{categoryLabel}</p>

				<h1>{title}</h1>

				<p class="article-description">
					{description}
				</p>

				<div class="article-meta">
					<span>
						Par <a href="/equipe-editoriale/">{author}</a>
					</span>

					<span>
						Publié le <FormattedDate date={pubDate} />
					</span>

					{
						updatedDate && (
							<span>
								Mis à jour le <FormattedDate date={updatedDate} />
							</span>
						)
					}
				</div>
			</header>

			{affiliate && <AffiliateDisclosure />}

			{
				heroImage && (
					<div class="article-hero-image">
						<Image
							src={heroImage}
							width={1600}
							height={900}
							alt={heroAlt ?? title}
							loading="eager"
						/>
					</div>
				)
			}

			{verdict && <VerdictBox text={verdict} />}

			<TableOfContents headings={headings} />

			<ProsCons pros={pros} cons={cons} />

			<div class="prose">
				<slot />
			</div>

			<div class="article-after-content">
				<FAQBlock items={faq} />
				<SourcesBlock sources={sources} title={sourcesTitle} />
			</div>
		</article>
	</div>
</BaseLayout>
