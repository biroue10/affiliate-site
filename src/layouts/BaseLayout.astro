---
import type { ImageMetadata } from 'astro';

import BaseHead from '../components/BaseHead.astro';
import AffiliateTracking from '../components/AffiliateTracking.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getAlternatePath, getLocale, type Locale } from '../lib/i18n';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	canonical?: string;
	noindex?: boolean;
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	adultContent?: boolean;
	schemas?: Record<string, unknown>[];
	language?: Locale;
}

const {
	title,
	description,
	image,
	canonical,
	noindex = false,
	type = 'website',
	publishedTime,
	modifiedTime,
	adultContent = false,
	schemas = [],
	language = getLocale(Astro.url.pathname),
} = Astro.props;

const frAlternate = getAlternatePath(Astro.url.pathname, 'fr');
const enAlternate = getAlternatePath(Astro.url.pathname, 'en');
---

<!doctype html>
<html lang={language}>
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			canonical={canonical}
			noindex={noindex}
			type={type}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
			adultContent={adultContent}
			language={language}
			frAlternate={frAlternate}
			enAlternate={enAlternate}
		/>

		{
			schemas.map((schema) => (
				<script
					type="application/ld+json"
					is:inline
					set:html={JSON.stringify(schema)}
				/>
			))
		}
	</head>

	<body>
		<a class="skip-link" href="#main-content">
			{language === 'en' ? 'Skip to content' : 'Aller au contenu'}
		</a>

		<Header language={language} />

		<main id="main-content">
			<slot />
		</main>

		<Footer language={language} />

		<AffiliateTracking />
	</body>
</html>
