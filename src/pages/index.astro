---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryIcon from '../components/CategoryIcon.astro';

import {
	SITE_DESCRIPTION,
	SITE_LANG,
	SITE_TITLE,
} from '../consts';

import {
	getPostPath,
	getPublishedPosts,
} from '../lib/content';

const latestPosts = (await getPublishedPosts()).slice(0, 6);

const siteBase = Astro.site ?? new URL(Astro.url.origin);

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	url: new URL('/', siteBase).href,
	inLanguage: SITE_LANG,
};
---

<BaseLayout
	title={SITE_TITLE}
	description={SITE_DESCRIPTION}
	schemas={[websiteSchema]}
>
	<section class="hero">
		<div class="container hero-inner">
			<p class="eyebrow">Guides · Avis · Comparatifs</p>

			<h1>
				Comparer, comprendre
				<br />
				et choisir en
				<br />
				connaissance de cause<span class="title-dot">.</span>
			</h1>

			<p class="hero-description">
				Des analyses indépendantes pour comparer les plateformes, comprendre leurs
				avantages et identifier leurs limites.
			</p>

			<a class="primary-button" href="/comparatifs/">
				Voir les comparatifs
			</a>
		</div>
	</section>

	<section class="container section">
		<header class="section-heading">
			<p class="eyebrow">Explorer</p>

			<h2 class="decorated-title">
				Nos catégories
			</h2>
		</header>

		<div class="category-grid">
			<a class="category-card" href="/avis/">
				<CategoryIcon type="avis" />
				<div>
					<h3>Avis</h3>
					<p>Analyses détaillées de plateformes et services.</p>
				</div>
			</a>

			<a class="category-card" href="/comparatifs/">
				<CategoryIcon type="comparatifs" />
				<div>
					<h3>Comparatifs</h3>
					<p>Comparaisons directes entre plusieurs services.</p>
				</div>
			</a>

			<a class="category-card" href="/guides/">
				<CategoryIcon type="guides" />
				<div>
					<h3>Guides</h3>
					<p>Conseils pratiques, sécurité et confidentialité.</p>
				</div>
			</a>

			<a class="category-card" href="/rencontres/">
				<CategoryIcon type="rencontres" />
				<div>
					<h3>Rencontres</h3>
					<p>Guides et comparatifs autour des rencontres pour adultes.</p>
				</div>
			</a>

			<a class="category-card" href="/ai/">
				<CategoryIcon type="ai" />
				<div>
					<h3>Compagnons IA</h3>
					<p>Analyses des services de compagnons et partenaires IA.</p>
				</div>
			</a>
		</div>
	</section>

	{
		latestPosts.length > 0 && (
			<section class="container section">
				<header class="section-heading">
					<p class="eyebrow">Nouveautés</p>

					<h2>Dernières publications</h2>
				</header>

				<div class="article-grid">
					{
						latestPosts.map((post) => (
							<article class="article-card">
								<p class="article-category">
									{post.data.category}
								</p>

								<h3>
									<a href={getPostPath(post)}>
										{post.data.title}
									</a>
								</h3>

								<p>{post.data.description}</p>
							</article>
						))
					}
				</div>
			</section>
		)
	}
</BaseLayout>
