---
import BaseLayout from '../layouts/BaseLayout.astro';

import {
	SITE_CATEGORIES,
	SITE_DESCRIPTION,
	SITE_LANG,
	SITE_TAGLINE,
	SITE_TITLE,
} from '../consts';

import {
	getPostPath,
	getPublishedPosts,
} from '../lib/content';

const latestPosts = (await getPublishedPosts()).slice(0, 6);

const siteBase = Astro.site ?? new URL(Astro.url.origin);

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	url: new URL('/', siteBase).href,
	inLanguage: SITE_LANG,
};
---

<BaseLayout
	title={SITE_TITLE}
	description={SITE_DESCRIPTION}
	schemas={[websiteSchema]}
>
	<section class="hero">
		<div class="container">
			<p class="eyebrow">Guides · Avis · Comparatifs</p>

			<h1>{SITE_TAGLINE}</h1>

			<p class="hero-description">
				Des analyses indépendantes pour comparer les plateformes,
				comprendre leurs avantages et identifier leurs limites.
			</p>

			<a class="primary-button" href="/comparatifs/">
				Voir les comparatifs
			</a>
		</div>
	</section>

	<section class="container section">
		<header class="section-heading">
			<p class="eyebrow">Explorer</p>

			<h2>Nos catégories</h2>
		</header>

		<div class="category-grid">
			{
				SITE_CATEGORIES.map((category) => (
					<a
						class="category-card"
						href={`/${category.slug}/`}
					>
						<h3>{category.label}</h3>

						<p>{category.description}</p>
					</a>
				))
			}
		</div>
	</section>

	{
		latestPosts.length > 0 && (
			<section class="container section">
				<header class="section-heading">
					<p class="eyebrow">Nouveautés</p>

					<h2>Dernières publications</h2>
				</header>

				<div class="article-grid">
					{
						latestPosts.map((post) => (
							<article class="article-card">
								<p class="article-category">
									{post.data.category}
								</p>

								<h3>
									<a href={getPostPath(post)}>
										{post.data.title}
									</a>
								</h3>

								<p>{post.data.description}</p>
							</article>
						))
					}
				</div>
			</section>
		)
	}
</BaseLayout>
